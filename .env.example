# Copy the values from your Supabase project (Project Settings -> API) and
# your Google AI Studio account (aistudio.google.com -> Get API key). Set these
# on Vercel (Project Settings -> Environment Variables) for the deployed app.
#
# Leave everything unset for local mock-data mode (no real backend, no auth).

# --- Client-safe: bundled into the app, protected by RLS, not secret ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only: never prefix these with EXPO_PUBLIC_, never ship to the client ---
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# --- Optional: only needed for native (iOS/Android) builds ---
# Web deploys call /api/* on the same origin and can leave this unset.
# Native builds have no "origin", so point this at the deployed Vercel URL.
EXPO_PUBLIC_API_BASE_URL=

# --- Optional: Terra wearable aggregator (Oura/Garmin/Fitbit/Whoop/...) ---
# From the Terra dashboard (dashboard.tryterra.co). Server-only secrets.
TERRA_DEV_ID=
TERRA_API_KEY=
# The per-destination "Signing Secret" for your webhook — verifies inbound
# Terra webhooks. Without it, /api/terra-webhook rejects everything.
TERRA_SIGNING_SECRET=
# Optional: restrict which providers the connect widget offers
# (comma-separated, e.g. OURA,GARMIN,FITBIT,WHOOP). Unset = Terra's default set.
TERRA_PROVIDERS=
# Client-safe flag: set to "true" to show the "Connect a wearable" button.
# Leave unset until the Terra secrets above are configured.
EXPO_PUBLIC_TERRA_ENABLED=

# --- Optional: transactional email (post-quiz "upload your labs" welcome) ---
# Uses the Resend API. Leave both unset to disable app-sent email entirely
# (/api/send-welcome no-ops). RESEND_FROM should be the SAME verified sender you
# configured for Supabase auth emails, e.g. "AI Wellness <noreply@your-domain>".
RESEND_API_KEY=
RESEND_FROM=
# Absolute URL of the deployed app, used as the email CTA button target
# (e.g. https://ai-longev-wellness.vercel.app). Unset = email omits the button.
APP_URL=

# --- Optional: Apple Health auto-sync (Health Auto Export app) — DEFERRED ---
# Shipping Terra first; this path is built but gated off. Leave unset. Set to
# "true" later (with Supabase configured) to surface the "Auto-sync from iPhone"
# option — no code change needed.
EXPO_PUBLIC_HEALTH_EXPORT_ENABLED=
