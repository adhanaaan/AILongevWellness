{
  "expo": {
    "name": "AI Wellness",
    "slug": "ai-wellness",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ai-wellness",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.aiwellness.app",
      "supportsTablet": false,
      "backgroundColor": "#FAFAFA",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "AI Wellness uses your camera so you can photograph a lab report or body composition scan to upload.",
        "NSPhotoLibraryUsageDescription": "AI Wellness accesses your photo library so you can upload a saved lab report or body composition scan."
      }
    },
    "android": {
      "package": "com.aiwellness.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FAFAFA"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAFA"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#2C4A38",
          "defaultChannel": "reminders"
        }
      ]
    ],
    "extra": {}
  }
}
