{
  "name": "ai-wellness-monorepo",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm run start --workspace @aiw/web",
    "build:web": "npm run build:web --workspace @aiw/web",
    "dev:shell": "npm --prefix packages/shell run start",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}
